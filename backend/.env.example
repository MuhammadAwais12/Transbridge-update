# Copy to .env and fill in. Placeholders only - never commit real values.

# --- Database (DB_HOST, DB_USER, DB_PASSWORD, DB_NAME are required at startup) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=<db user>
DB_PASSWORD=<db password>
DB_NAME=<db name>
# "true" enables SSL (rejectUnauthorized: false)
DB_SSL=false
# "true" lets TypeORM auto-sync the schema. Local development only.
DB_SYNC=false

# --- Auth (required: the app refuses to start without it) ---
JWT_SECRET=<long random string>

# --- HTTP ---
# Comma-separated list of allowed CORS origins (default http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Max JSON / urlencoded request body size (default 15mb)
BODY_LIMIT=15mb
# Max size of a POST /upload file in MB (default 10)
UPLOAD_MAX_FILE_SIZE_MB=10

# Shared secret required in the x-registration-key header for POST /msb-admin/register.
# Leave unset to disable admin registration entirely.
REGISTRATION_KEY=<random string>

# --- Payment providers (read only by src/config/providers.config.ts) ---
# Values are checked when a provider call is made, not at startup.
# Bridge, via the Transbridge proxy (required for /bridge/* calls)
PROVIDER_BRIDGE_API_URL=<Bridge API base URL>
PROVIDER_BRIDGE_API_KEY=<Bridge API key>
# Optional, default 60000
PROVIDER_BRIDGE_TIMEOUT_MS=60000

# BlindPay online-banking gateway (URL required for BlindPay calls; API key optional)
PROVIDER_ONLINE_BANKING_URL=<online-banking gateway base URL>
PROVIDER_ONLINE_BANKING_API_KEY=<gateway x-api-key>
# Optional, default 10000
PROVIDER_ONLINE_BANKING_TIMEOUT_MS=10000

# BlindPay (required for BlindPay calls; the webhook secret for POST /webhook)
PROVIDER_BLINDPAY_API_KEY=<BlindPay API key>
PROVIDER_BLINDPAY_INSTANCE_ID=<BlindPay instance id>
PROVIDER_BLINDPAY_WEBHOOK_SECRET=<whsec_... signing secret>

# Optional fallback BlindPay receiver id for business clients whose MSB has no customer_id
PROVIDER_ORIGINAL_TECH_ACCOUNT_ID=<receiver id>

# --- Email (Resend) ---
RESEND_API_KEY=<Resend API key>

# --- Brand (read only by src/config/brand.config.ts; all optional, neutral defaults) ---
# Shown in emails, the Swagger title and 2FA authenticator labels (default: Your Company)
COMPANY_NAME=<company name>
# Sender display name (default: COMPANY_NAME) and address (default: noreply@example.com).
# The address must be on a domain verified in Resend, or sending fails.
EMAIL_FROM_NAME=<sender display name>
EMAIL_FROM_ADDRESS=<noreply@your-domain>
# Support contact shown in emails and used as reply-to (default: support@example.com)
SUPPORT_EMAIL=<support@your-domain>
# Optional logo in the email header (absolute https URL); no logo when unset
EMAIL_LOGO_URL=<https://your-domain/logo.png>
# Hex color for email buttons and accents (default: #007bff)
BRAND_PRIMARY_COLOR=<#rrggbb>
# Login link in the welcome email (default: http://localhost:5173/login). Its origin is also the
# fallback base for KYC links (after NEXT_PUBLIC_DASHBOARD_URL / DASHBOARD_URL) and
# reset-password links (after FRONTEND_URL).
DASHBOARD_LOGIN_URL=<https://your-dashboard/login>

# --- S3 uploads (src/upload/upload.service.ts) ---
# The code reads these two names; region (eu-north-1) and bucket (transbridge-dashboard) are hardcoded.
# No AWS_* variables are read anywhere in src/.
NEXT_PUBLIC_S3_ACCESS_KEY=<AWS access key id>
NEXT_PUBLIC_S3_SECRET_KEY=<AWS secret access key>
